# Neon Serverless Postgres (Pooled URI with -pooler, used by runtime src/db/index.ts)
DATABASE_URL="postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Neon Serverless Postgres (Direct unpooled URI, used by drizzle-kit & src/db/seed.ts)
DIRECT_DATABASE_URL="postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Repo-scoped Fine-Grained GitHub Personal Access Token (Actions: R/W, Contents: R, Pull requests: R, Metadata: R)
GITHUB_PAT="github_pat_..."

# Single-admin login credentials
ADMIN_USERNAME="ankul"
ADMIN_PASSWORD=""

# 32+ char random hex secret for HMAC session signing (openssl rand -hex 32)
SESSION_SECRET="replace-with-64-char-hex-secret"

# 32+ char random hex secret for GitHub webhook X-Hub-Signature-256 verification
GITHUB_WEBHOOK_SECRET="replace-with-64-char-hex-secret"

# 32+ char random hex Bearer token for Phase 2 GitHub Actions workflow callbacks
ORCHESTRATOR_CALLBACK_SECRET="replace-with-64-char-hex-secret"

# 32+ char random hex secret for reusable deploy workflow X-Factory-Signature-256 verification
FACTORY_WEBHOOK_SECRET="replace-with-64-char-hex-secret"
